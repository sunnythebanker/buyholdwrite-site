---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About Sunny Sun — buyholdwrite.com"
  description="Banker in the US — 9 years inside a top US bank, 9 years building a family flower business. Today teaching 401K rollovers, self-directed IRAs, and US investing for non-residents."
>
  <!-- Section 1: Hero -->
  <section class="about-hero">
    <div class="about-hero-text">
      <h1>Sunny Sun</h1>
    </div>
    <div class="about-photo">
      <img src="/logos/stack-icon-light.svg" alt="" class="about-photo-mark" />
      <p class="about-photo-text">Headshot coming soon</p>
    </div>
  </section>

  <!-- Section 2: Standing bio callout (Brief §3.3 verbatim) -->
  <section class="bio-band">
    <p class="bio-callout">
      Banker in the United States. 9 years inside a top US bank. 9 years building a family flower business with my wife — first 4 years alongside the bank job, 5 years full-time. Today I help people navigate 401K rollovers, self-directed IRAs, and US investing for non-residents. Bilingual (English / 中文). Educational only — not financial advice.
    </p>
  </section>

  <!-- Section 3: Narrative placeholder (real prose lands when Sunny writes it) -->
  <section class="narrative-band">
    <p class="narrative-placeholder">
      The full story — the years inside the bank, why I started writing, what this site is now — is being written. It'll publish here as soon as it's ready. In the meantime, the weekly newsletter is the closest thing to reading along.
    </p>
  </section>

  <!-- Section 4: What I teach + Who STACK isn't for -->
  <section class="teach-band">
    <div class="teach-grid">
      <div class="teach-col">
        <h2>What I teach.</h2>
        <ul>
          <li><span class="mark" aria-hidden="true">→</span><span>401(k) Rollovers</span></li>
          <li><span class="mark" aria-hidden="true">→</span><span>Self-Directed IRAs</span></li>
          <li><span class="mark" aria-hidden="true">→</span><span>NRA Investing</span></li>
        </ul>
      </div>
      <div class="teach-col not-for">
        <h2>Who STACK isn't for.</h2>
        <ul>
          <li><span class="mark" aria-hidden="true">✕</span><span>People with under $50K in their IRA</span></li>
          <li><span class="mark" aria-hidden="true">✕</span><span>People who can't watch markets 30 min/day</span></li>
          <li><span class="mark" aria-hidden="true">✕</span><span>People emotionally tied to outperforming</span></li>
          <li><span class="mark" aria-hidden="true">✕</span><span>People who need passive income now</span></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Section 5: Newsletter signup (mirrors Home Section 5; consolidate to component at 3rd occurrence) -->
  <section class="newsletter-band">
    <div class="signup-block">
      <div class="eyebrow">The weekly STACK newsletter</div>
      <h3>The weekly STACK newsletter. Free. Educational only.</h3>
      <p class="sub">Every Friday: trade walk-through, market read, one banker insight.</p>
      <form class="signup-row" action="/newsletter" method="get">
        <input type="email" name="email" placeholder="name@example.com" aria-label="Email address" required />
        <button type="submit">Subscribe →</button>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  /* ===== Section 1: Hero ===== */
  .about-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: center;
    padding: var(--space-12) var(--space-5);
    max-width: 1200px;
    margin: 0 auto;
  }
  .about-hero h1 {
    /* spec value; no matching type token (--type-hero-size is 56px) */
    font-size: 84px;
    line-height: 1.0;
    color: var(--color-navy);
    letter-spacing: -0.02em;
  }
  .about-photo {
    aspect-ratio: 4 / 5;
    background: var(--color-navy);
    border-radius: var(--radius-lg);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
  }
  .about-photo-mark {
    width: 40%;
    height: auto;
  }
  .about-photo-text {
    color: var(--color-warm-white);
    font-family: var(--font-body);
    font-size: 14px;
    letter-spacing: 0.05em;
    opacity: 0.72;
    margin: 0;
  }

  /* ===== Section 2: Standing bio callout ===== */
  .bio-band {
    padding: var(--space-8) var(--space-5);
    background: var(--bg-page);
  }
  .bio-callout {
    max-width: 880px;
    margin: 0 auto;
    background: var(--bg-callout-navy);
    border-left: 4px solid var(--color-gold);
    padding: var(--space-5) var(--space-6);
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    /* spec value; no matching token (closest --type-pullquote-size is 20px) */
    font-size: 24px;
    line-height: 1.45;
    color: var(--color-navy);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
  }

  /* ===== Section 3: Narrative placeholder ===== */
  .narrative-band {
    padding: var(--space-8) var(--space-5) var(--space-12);
  }
  .narrative-placeholder {
    max-width: 680px;
    margin: 0 auto;
    font-family: var(--font-body);
    font-size: var(--type-article-size);
    line-height: var(--type-article-lh);
    color: var(--text-muted);
    text-align: center;
  }

  /* ===== Section 4: What I teach + Who STACK isn't for ===== */
  .teach-band {
    padding: var(--space-12) var(--space-5);
    background: var(--bg-surface-alt);
    border-top: 1px solid var(--border-default);
    border-bottom: 1px solid var(--border-default);
  }
  .teach-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
    max-width: 1100px;
    margin: 0 auto;
  }
  .teach-col h2 {
    /* spec value (mockup used h3 at this size; promoted to h2 for heading hierarchy) */
    font-size: 28px;
    line-height: 1.2;
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }
  .teach-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .teach-col li {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--border-default);
    /* spec value; no matching token (--type-body-size is 17px) */
    font-size: 16px;
    line-height: 1.5;
    display: flex;
    gap: var(--space-2);
    align-items: flex-start;
  }
  .teach-col .mark {
    flex: 0 0 22px;
    font-weight: 700;
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: 14px;
    margin-top: 2px;
  }
  .teach-col.not-for .mark {
    color: var(--color-crimson);
  }

  /* ===== Section 5: Newsletter signup ===== */
  .newsletter-band {
    padding: var(--space-12) var(--space-5);
    background: var(--bg-page);
  }
  .signup-block {
    background: var(--bg-callout-navy);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }
  .signup-block .eyebrow {
    font-size: 11px;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--color-gold);
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: var(--space-1);
  }
  .signup-block h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    color: var(--color-navy);
    line-height: 1.2;
    margin-bottom: var(--space-1);
  }
  .signup-block .sub {
    font-size: 16px;
    color: var(--text-muted);
    margin-bottom: var(--space-3);
  }
  .signup-block .signup-row {
    display: flex;
    gap: 8px;
    justify-content: center;
    max-width: 480px;
    margin: 0 auto;
    flex-wrap: wrap;
  }
  .signup-block .signup-row input {
    flex: 1;
    min-width: 200px;
    font-family: var(--font-body);
    font-size: 15px;
    padding: 12px 14px;
    background: #fff;
    color: var(--color-text);
    border: 1px solid var(--border-input);
    border-radius: var(--radius-md);
  }
  .signup-block .signup-row button {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    background: var(--color-gold);
    color: var(--color-navy);
    border: 2px solid var(--color-gold);
    padding: 12px 22px;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  /* ===== Mobile (≤780px) ===== */
  @media (max-width: 780px) {
    .about-hero {
      display: flex;
      flex-direction: column;
      padding: var(--space-5) var(--space-3);
      gap: var(--space-3);
    }
    .about-photo {
      order: -1; /* photo above name on mobile (face first) */
    }
    .about-hero h1 {
      /* spec value; no matching token */
      font-size: 48px;
      line-height: 1.0;
    }
    .bio-band {
      padding: var(--space-4) var(--space-3);
    }
    .bio-callout {
      font-size: var(--type-article-size);
      line-height: 1.5;
      padding: var(--space-3);
    }
    .narrative-band {
      padding: var(--space-4) var(--space-3) var(--space-6);
    }
    .narrative-placeholder {
      /* spec value; no matching token */
      font-size: 16px;
      line-height: 1.65;
    }
    .teach-band {
      padding: var(--space-6) var(--space-3);
    }
    .teach-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .teach-col h2 {
      /* spec value */
      font-size: 22px;
    }
    .newsletter-band {
      padding: var(--space-6) var(--space-3);
    }
    .signup-block {
      padding: var(--space-4) var(--space-3);
    }
    .signup-block h3 {
      font-size: 22px;
    }
  }
</style>
