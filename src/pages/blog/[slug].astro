---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { author } from '../../data/author';

export async function getStaticPaths() {
  const articles = await getCollection('blog');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article, allArticles: articles },
  }));
}

type Props = {
  article: CollectionEntry<'blog'>;
  allArticles: CollectionEntry<'blog'>[];
};

const { article, allArticles } = Astro.props as Props;
const { Content } = await render(article);
const { data, body } = article;

// Decision I — cat-pill display label (inline const; rule of three not yet met).
const CATEGORY_LABELS: Record<string, string> = {
  '401k-rollover': '401K Rollover',
  'self-directed-ira': 'Self-Directed IRA',
  'nra-investing': 'NRA Investing',
};
const categoryLabel = CATEGORY_LABELS[data.category];

const fmtMonthYear = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
const publishedLabel = fmtMonthYear(data.publish_date);
const updatedLabel = fmtMonthYear(data.last_updated);
const showUpdated = updatedLabel !== publishedLabel;

// Decision J — read-time from word count, 200 WPM, min 1.
const wordCount = (body ?? '').split(/\s+/).filter(Boolean).length;
const readMinutes = Math.max(1, Math.round(wordCount / 200));

// Decision B — related articles (3 same category, hidden when count = 0).
const related = allArticles
  .filter((a) => a.data.slug !== data.slug && a.data.category === data.category)
  .sort((a, b) => b.data.publish_date.getTime() - a.data.publish_date.getTime())
  .slice(0, 3);

const SITE_URL = 'https://buyholdwrite.com';
const articleUrl = `${SITE_URL}/blog/${data.slug}`;
// OG image — file generated by Build_03 §3.7 satori task (not yet shipped).
// URL pattern documented; resolves when satori integration lands.
const ogImage = `${SITE_URL}/og/${data.slug}.png`;

// Decision E — emit Article JSON-LD for all schema_type values in v1.
// FAQPage / HowTo enum values accepted by frontmatter but treated as Article
// until mainEntity / itemListElement parsers exist (logged as known gap).
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: data.title,
  description: data.description,
  datePublished: data.publish_date.toISOString().slice(0, 10),
  dateModified: data.last_updated.toISOString().slice(0, 10),
  author: {
    '@type': 'Person',
    name: author.name,
    url: author.url,
  },
  publisher: {
    '@type': 'Organization',
    name: 'buyholdwrite.com',
    url: SITE_URL,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE_URL}/logos/stack-icon-light.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  image: ogImage,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE_URL}/blog` },
    { '@type': 'ListItem', position: 3, name: data.title, item: articleUrl },
  ],
};

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: author.name,
  url: author.url,
  description: author.bio,
  sameAs: [author.social.youtube, author.social.x],
};
---

<BaseLayout
  title={`${data.title} — buyholdwrite.com`}
  description={data.description}
  ogType="article"
  ogImage={ogImage}
  canonicalPath={`/blog/${data.slug}`}
  currentPath="/blog"
>
  <div slot="progress-bar" class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="reading-progress-bar"></div>
  </div>

  <article class="article-shell">
    <header class="article-header">
      <span class="cat-pill">{categoryLabel}</span>
      <h1>{data.title}</h1>
      <div class="article-meta-row">
        <a class="byline" href="/about">
          <span class="byline-avatar" aria-hidden="true">S</span>
          <span>By Sunny Sun</span>
        </a>
        <div class="article-meta-dates">
          Published {publishedLabel}{showUpdated ? ` · Updated ${updatedLabel}` : ''} · {readMinutes} min read
        </div>
      </div>
    </header>

    <div class="article-body">
      <Content />
    </div>

    <aside class="article-disclaimer" aria-labelledby="article-disclaimer-label">
      <span id="article-disclaimer-label" class="article-disclaimer-label">Disclaimer</span>
      Educational only — not financial advice. Sunny Sun is not a registered investment advisor. The information presented on this site is for educational purposes only and does not constitute investment advice, financial advice, or any other type of advice. Always consult with a qualified professional before making investment decisions.
    </aside>
  </article>

  <section class="article-author">
    <span class="article-author-avatar" aria-hidden="true">S</span>
    <div>
      <h4>{author.name}</h4>
      <p>{author.bio}</p>
      <a href="/about" class="article-author-read-more">Read more about me →</a>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section">
      <h3>Related articles</h3>
      <div class="related-grid">
        {related.map((r) => {
          const rWords = (r.body ?? '').split(/\s+/).filter(Boolean).length;
          const rMin = Math.max(1, Math.round(rWords / 200));
          return (
            <a class="related-card" href={`/blog/${r.data.slug}`}>
              <span class="cat-pill">{CATEGORY_LABELS[r.data.category]}</span>
              <h4>{r.data.title}</h4>
              <p>{r.data.description}</p>
              <div class="related-card-foot">{fmtMonthYear(r.data.publish_date)} · {rMin} min read</div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <section class="article-newsletter">
    <NewsletterSignup />
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
</BaseLayout>

<script is:inline>
  (function () {
    const bar = document.getElementById('reading-progress-bar');
    const article = document.querySelector('.article-shell');
    if (!bar || !article) return;
    function update() {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = -rect.top;
      const pct = total > 0 ? Math.min(100, Math.max(0, (scrolled / total) * 100)) : 0;
      bar.style.width = pct + '%';
    }
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  })();
</script>

<style>
  /* ====================================================================
     READING PROGRESS BAR
     ==================================================================== */
  .reading-progress {
    position: sticky;
    top: 0;
    height: 3px;
    background: rgba(27, 42, 74, 0.06);
    z-index: 60;
    overflow: hidden;
  }
  .reading-progress-bar {
    height: 100%;
    width: 0%;
    background: var(--color-gold);
    transition: width 0.05s linear;
  }

  /* ====================================================================
     ARTICLE SHELL + HEADER
     ==================================================================== */
  .article-shell {
    max-width: 680px;
    margin: 0 auto;
    padding: var(--space-6) var(--space-3) var(--space-3);
  }
  .article-header {
    margin-bottom: var(--space-5);
  }
  .article-header .cat-pill {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-navy);
    background: var(--color-gold);
    padding: 5px 12px;
    border-radius: var(--radius-pill);
    margin-bottom: var(--space-3);
  }
  .article-header h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 46px;
    line-height: 1.1;
    color: var(--color-navy);
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-3);
  }
  .article-meta-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border-bottom: 1px solid var(--border-default);
    padding-bottom: var(--space-3);
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--color-navy);
    font-weight: 600;
    text-decoration: none;
  }
  .byline-avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(135deg, #E8E2D2 0%, #C5A55A 100%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 14px;
  }
  .article-meta-dates {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* ====================================================================
     ARTICLE BODY — scoped wrapper + :global descendants
     ==================================================================== */
  .article-body {
    font-size: 18px;
    line-height: 1.75;
    color: var(--text-primary);
  }
  .article-body > :global(p) {
    margin: 0 0 var(--space-3);
  }
  /* Lead — first <p> direct child of .article-body */
  .article-body > :global(p:first-of-type) {
    font-size: 21px;
    line-height: 1.55;
    color: var(--color-navy);
    font-weight: 400;
  }
  .article-body > :global(h2) {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 28px;
    color: var(--color-navy);
    line-height: 1.2;
    margin: var(--space-6) 0 var(--space-2);
    letter-spacing: -0.01em;
  }
  .article-body > :global(h3) {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 22px;
    color: var(--color-charcoal);
    line-height: 1.25;
    margin: var(--space-5) 0 var(--space-1);
  }

  /* Links — internal vs external by href attribute */
  .article-body :global(a[href^="/"]),
  .article-body :global(a[href^="http"]) {
    color: var(--color-navy);
    text-decoration: none;
    border-bottom: 1px solid rgba(27, 42, 74, 0.3);
    transition: border-bottom-color 0.15s ease;
  }
  .article-body :global(a[href^="/"]):hover,
  .article-body :global(a[href^="http"]):hover {
    border-bottom-color: var(--color-gold);
  }
  .article-body :global(a[href^="http"])::after {
    content: ' ↗';
    font-size: 0.8em;
    color: var(--color-gold);
  }

  /* Lists */
  .article-body > :global(ul),
  .article-body > :global(ol) {
    margin: 0 0 var(--space-3) var(--space-3);
    padding-left: var(--space-2);
  }
  .article-body :global(li) {
    margin-bottom: 8px;
  }

  /* Pull quote (raw HTML: <div class="pullquote">) */
  .article-body > :global(.pullquote) {
    margin: var(--space-5) 0;
    border-left: 3px solid var(--color-gold);
    padding: 6px 0 6px var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 22px;
    line-height: 1.4;
    color: var(--color-navy);
  }
  .article-body :global(.pullquote cite) {
    display: block;
    font-family: var(--font-body);
    font-style: normal;
    font-size: 13px;
    color: var(--text-muted);
    margin-top: var(--space-2);
    letter-spacing: 0.04em;
  }

  /* Callout (raw HTML: <div class="callout">) */
  .article-body > :global(.callout) {
    background: var(--bg-callout-navy);
    border-left: 4px solid var(--color-gold);
    padding: var(--space-3);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    margin: var(--space-4) 0;
    font-size: 16px;
    line-height: 1.6;
  }
  .article-body :global(.callout .label) {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 6px;
  }
  .article-body :global(.callout p) {
    margin: 0 0 8px;
    font-size: inherit;
    color: var(--text-primary);
    font-weight: 400;
  }
  .article-body :global(.callout p:last-child) {
    margin-bottom: 0;
  }

  /* Figure + caption */
  .article-body > :global(figure) {
    margin: var(--space-4) 0;
  }
  .article-body :global(figure .img-placeholder) {
    background: var(--bg-surface-alt);
    border: 1px dashed var(--border-default);
    border-radius: var(--radius-md);
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  .article-body :global(figcaption) {
    font-size: 13px;
    color: var(--text-muted);
    font-style: italic;
    text-align: center;
    margin-top: 10px;
  }

  /* Tables */
  .article-body > :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: var(--space-3) 0 var(--space-4);
    font-family: var(--font-body);
    font-size: 14px;
  }
  .article-body :global(thead) {
    background: var(--color-navy);
    color: var(--text-on-dark);
  }
  .article-body :global(th) {
    padding: 10px 14px;
    text-align: left;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: 0.04em;
  }
  .article-body :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--border-default);
  }
  .article-body :global(tbody tr:nth-child(odd)) {
    background: var(--bg-page);
  }
  .article-body :global(tbody tr:nth-child(even)) {
    background: var(--bg-surface-alt);
  }

  /* Code blocks — Astro/Shiki emits <pre class="astro-code">.
     Override background to charcoal + add gold left border + radius. */
  .article-body > :global(pre) {
    background: var(--color-charcoal) !important;
    font-size: 14px;
    line-height: 1.65;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-gold);
    margin: var(--space-3) 0 var(--space-4);
    overflow-x: auto;
  }
  .article-body :global(pre code) {
    font-family: var(--font-mono);
    background: transparent;
  }
  /* Inline code */
  .article-body :global(:not(pre) > code) {
    background: var(--bg-surface-alt);
    color: var(--color-navy);
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 1px 5px;
    border-radius: 3px;
  }

  /* FAQ accordion — HTML5 native <details>/<summary> (Decision D) */
  .article-body > :global(details) {
    border-bottom: 1px solid var(--border-default);
    padding: var(--space-2) 0;
  }
  .article-body > :global(details:first-of-type) {
    border-top: 1px solid var(--border-default);
    margin-top: var(--space-3);
  }
  .article-body :global(summary) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    color: var(--color-navy);
    list-style: none;
    padding: var(--space-1) 0;
  }
  .article-body :global(summary::-webkit-details-marker) {
    display: none;
  }
  .article-body :global(summary::after) {
    content: '+';
    font-family: var(--font-mono);
    color: var(--color-gold);
    font-size: 18px;
    transition: transform 0.15s ease;
    flex: 0 0 auto;
    margin-left: var(--space-2);
  }
  .article-body :global(details[open] summary::after) {
    transform: rotate(45deg);
  }
  .article-body :global(details > *:not(summary)) {
    margin-top: var(--space-1);
    color: var(--text-primary);
    font-size: 16px;
    line-height: 1.65;
  }

  /* ====================================================================
     IN-ARTICLE DISCLAIMER BLOCK
     ==================================================================== */
  .article-disclaimer {
    background: var(--bg-surface-alt);
    border-left: 4px solid var(--color-gold);
    padding: var(--space-3);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-primary);
    margin: var(--space-5) 0;
  }
  .article-disclaimer-label {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-navy);
    margin-bottom: 6px;
    display: block;
  }

  /* ====================================================================
     AUTHOR BIO BLOCK
     ==================================================================== */
  .article-author {
    display: flex;
    gap: var(--space-3);
    background: #fff;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    margin: var(--space-6) auto 0;
    max-width: 680px;
  }
  .article-author-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    flex: 0 0 80px;
    background: linear-gradient(135deg, #E8E2D2 0%, #C5A55A 100%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-navy);
    font-size: 32px;
  }
  .article-author h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--color-navy);
    margin: 0 0 6px;
  }
  .article-author p {
    font-size: 14px;
    line-height: 1.55;
    margin: 0 0 8px;
    color: var(--text-primary);
  }
  .article-author-read-more {
    color: var(--color-navy);
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid var(--color-gold);
  }

  /* ====================================================================
     RELATED ARTICLES
     ==================================================================== */
  .related-section {
    max-width: 1100px;
    margin: var(--space-6) auto var(--space-3);
    padding: 0 var(--space-3);
  }
  .related-section h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 12.5px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 var(--space-3);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .related-card:hover {
    box-shadow: 0 4px 12px rgba(27, 42, 74, 0.08);
    border-color: rgba(27, 42, 74, 0.18);
  }
  .related-card .cat-pill {
    align-self: flex-start;
    font-family: var(--font-body);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-navy);
    background: var(--color-gold);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .related-card h4 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
    color: var(--color-navy);
    letter-spacing: -0.005em;
    margin: 0;
  }
  .related-card p {
    font-size: 14px;
    color: var(--text-primary);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .related-card-foot {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-top: auto;
    padding-top: var(--space-1);
  }

  /* ====================================================================
     NEWSLETTER SIGNUP WRAPPER
     ==================================================================== */
  .article-newsletter {
    padding: var(--space-6) var(--space-3) var(--space-8);
  }

  /* ====================================================================
     MOBILE (≤ 780px)
     ==================================================================== */
  @media (max-width: 780px) {
    .article-shell {
      padding: var(--space-3);
    }
    .article-header h1 {
      font-size: 30px;
    }
    .article-meta-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
    .article-meta-dates {
      margin-left: 0;
    }
    .article-body {
      font-size: 17px;
      line-height: 1.7;
    }
    .article-body > :global(p:first-of-type) {
      font-size: 18px;
    }
    .article-body > :global(h2) {
      font-size: 22px;
      margin: var(--space-4) 0 var(--space-1);
    }
    .article-body > :global(h3) {
      font-size: 18px;
      margin: var(--space-3) 0 6px;
    }
    .article-body > :global(pre) {
      font-size: 12.5px;
    }
    .article-body > :global(.pullquote) {
      font-size: 18px;
    }
    .article-body > :global(table) {
      display: block;
      overflow-x: auto;
    }
    .article-author {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
    .article-author-avatar {
      width: 64px;
      height: 64px;
      flex: 0 0 64px;
      font-size: 26px;
    }
    .related-grid {
      grid-template-columns: 1fr;
    }
    .article-newsletter {
      padding: var(--space-4) var(--space-3) var(--space-6);
    }
  }
</style>
