---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Disclaimer — buyholdwrite.com"
  description="Disclaimer for buyholdwrite.com — coming soon."
>
  <section class="placeholder">
    <h1>Disclaimer</h1>
    <p>Coming soon — full disclaimer publishing alongside v1 launch.</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    max-width: 720px;
    margin: 0 auto;
    padding: var(--space-12) var(--space-5);
    text-align: center;
  }
  .placeholder h1 {
    font-size: var(--type-h1-size);
    line-height: var(--type-h1-lh);
    color: var(--color-navy);
    margin-bottom: var(--space-3);
  }
  .placeholder p {
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.6;
  }
</style>
